{
  "expo": {
    "name": "Dongjin Solar",
    "slug": "solar",
    "version": "1.0.1",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "solar",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#070b12",
    "ios": {
      "icon": "./assets/images/icon.png",
      "requireFullScreen": true,
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses your camera to scan QR codes for solar plant data."
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#F6F7FA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "com.anonymous.solar",
      "versionCode": 12
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#0ea5e9",
          "defaultChannel": "solar-alerts"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070b12",
          "image": "./assets/images/splash-icon-dark.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ],
      "./plugins/with-notifee-maven-repo",
      "./plugins/with-local-release-signing",
      [
        "./plugins/with-gradle-daemon-jvm",
        {
          "toolchainVersion": 17
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4a77ee80-fab8-4926-89df-e25deca4feb3"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4a77ee80-fab8-4926-89df-e25deca4feb3",
      "requestHeaders": {
        "expo-channel-name": "preview"
      }
    }
  }
}
